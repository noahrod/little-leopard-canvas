extends SceneTree

const CanvasScript = preload("res://scripts/drawing_canvas.gd")

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var scene: Control = load("res://main.tscn").instantiate()
	scene.suppress_setup = true
	root.add_child(scene)
	await process_frame
	await process_frame
	var canvas: DrawingCanvas = scene.find_child("DrawingCanvas", true, false)
	assert(canvas != null)
	assert(canvas.size.x > 0 and canvas.size.y > 0)
	assert(canvas.tool == "brush")
	assert(scene.PAGE_NAMES == ["School", "Lowell", "Leopard", "Paw", "Art Club", "Blank"])
	assert(scene.get("selected_page") == 0)
	assert(scene.get("page_textures")[0].resource_path == "res://assets/coloring/school_clean.png")
	assert(scene.get("page_textures")[4].resource_path == "res://assets/coloring/app_icon_outline.png")
	assert(scene.get("page_textures")[5] == null)
	assert(not scene.get("page_buttons")[4].disabled)
	assert(not scene.get("page_buttons")[5].disabled)
	assert(not scene.page_dialog.visible)
	scene._open_pages()
	assert(scene.page_buttons[0].visible and scene.page_buttons[3].visible)
	assert(not scene.page_buttons[4].visible)
	scene._change_page_group(1)
	assert(not scene.page_buttons[0].visible and scene.page_buttons[4].visible and scene.page_buttons[5].visible)
	scene._request_page(4)
	assert(not scene.page_dialog.visible and scene.confirm_dialog.visible)
	scene._confirmation_canceled()
	scene.confirm_dialog.hide()
	await process_frame
	assert(scene.page_dialog.visible and scene.selected_page == 0)
	scene.page_dialog.hide()
	scene._open_text()
	await process_frame
	var dialog: ConfirmationDialog = scene.text_dialog
	var dialog_theme: Theme = dialog.theme
	var close_size := dialog_theme.get_icon("close", "Window").get_size()
	var title_height := dialog_theme.get_constant("title_height", "Window")
	var close_y := dialog_theme.get_constant("close_v_offset", "Window")
	var close_x := dialog_theme.get_constant("close_h_offset", "Window")
	var border: StyleBoxFlat = dialog_theme.get_stylebox("embedded_border", "Window")
	assert(close_size.x >= 48 and close_size.y >= 48)
	assert(title_height >= 64 and border.expand_margin_top >= title_height)
	assert(close_y <= title_height and close_y >= close_size.y and close_x >= close_size.x)
	assert(dialog_theme.get_font_size("title_font_size", "Window") >= 24)
	assert(dialog.get_ok_button().size.y >= 56 and dialog.get_cancel_button().size.y >= 56)
	assert(dialog.position.y - title_height >= 0)
	assert(dialog.position.y + dialog.size.y <= scene.size.y)
	dialog.hide()
	for button in scene.tool_buttons.values():
		assert(button.text.is_empty() and button.icon != null)
	var choices: PanelContainer = scene.find_child("ChoicesPanel", true, false)
	assert(choices.size.x <= 190)
	for button in scene.color_buttons:
		assert(button.size.x >= 54 and button.size.y >= 54)
		assert(choices.get_global_rect().encloses(button.get_global_rect()))
	for button in scene.stamp_buttons.values():
		assert(button.text.is_empty() and button.icon != null)
		assert(button.size.x >= 54 and button.size.y >= 56)
		assert(button.get_theme_constant("icon_max_width") >= 44)
		assert(choices.get_global_rect().encloses(button.get_global_rect()))
		assert(button.icon_alignment == HORIZONTAL_ALIGNMENT_CENTER)
		var image: Image = button.icon.get_image()
		var bounds := image.get_used_rect()
		assert(absi(bounds.position.x - (image.get_width() - bounds.end.x)) <= 1)
		assert(absi(bounds.position.y - (image.get_height() - bounds.end.y)) <= 1)
	var badge: TextureRect = scene.find_child("AppBadge", true, false)
	assert(badge.texture.resource_path == "res://assets/app_icon/little_leopard_canvas.png")
	var title: Label = scene.find_child("AppTitle", true, false)
	var title_font: FontVariation = title.get_theme_font("font")
	assert(title_font.base_font.resource_path == "res://assets/fonts/Fredoka.ttf")
	assert(title_font.variation_opentype[TextServerManager.get_primary_interface().name_to_tag("wght")] == 700)
	assert(title.size.x >= title.get_minimum_size().x)
	assert(title.get_global_rect().end.x <= scene.find_child("HeaderSettings", true, false).get_global_rect().position.x)
	var header_buttons := ["HeaderSettings", "HeaderGallery", "HeaderNew", "HeaderUndo", "HeaderClear", "HeaderSave"]
	for button_name in header_buttons:
		var header_button: Button = scene.find_child(button_name, true, false)
		assert(header_button != null and header_button.icon != null)
		assert(header_button.get_theme_font_size("font_size") == 14)
		assert(not header_button.tooltip_text.is_empty())
		assert(header_button.custom_minimum_size.y == 54)
		for state in ["normal", "hover", "pressed"]:
			var style: StyleBox = header_button.get_theme_stylebox(state)
			assert(style.content_margin_left == 12.0)
			assert(style.content_margin_right == 12.0)
		assert(header_button.get_theme_constant("h_separation") == 6)
	var undo_button: Button = scene.find_child("HeaderUndo", true, false)
	assert(undo_button.text.is_empty() and undo_button.icon_alignment == HORIZONTAL_ALIGNMENT_CENTER)
	var clear_button: Button = scene.find_child("HeaderClear", true, false)
	assert(absi(undo_button.get_index() - clear_button.get_index()) > 1)
	assert(scene.tool_buttons.has("zoom"))
	for button in scene.find_children("*", "Button", true, false):
		if button.is_visible_in_tree():
			var bounds: Rect2 = button.get_global_rect()
			if bounds.position.x < 0 or bounds.position.y < 0 or bounds.end.x > scene.size.x or bounds.end.y > scene.size.y:
				push_error("Button outside layout: %s %s, layout %s" % [button.text, bounds, scene.size])
				quit(1)
				return
	canvas.set_page(scene.get("page_textures")[4])
	canvas.set_tool("fill")
	canvas.set_color(Color.RED)
	canvas._start(Vector2(420.0 * canvas.size.x / canvas.WIDTH, 155.0 * canvas.size.y / canvas.HEIGHT))
	assert(canvas.artwork.get_pixel(420, 155).is_equal_approx(Color.RED))
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.WHITE))
	canvas.undo()
	canvas.set_page(null)
	canvas.set_tool("brush")
	var initial := canvas.artwork.get_pixel(100, 100)
	canvas.set_color(Color.RED)
	canvas._start(Vector2(100.0 * canvas.size.x / canvas.WIDTH, 100.0 * canvas.size.y / canvas.HEIGHT))
	canvas._finish()
	assert(canvas.artwork.get_pixel(100, 100).is_equal_approx(Color.RED))
	canvas.undo()
	assert(canvas.artwork.get_pixel(100, 100).is_equal_approx(initial))

	canvas.set_tool("zoom")
	canvas._start(canvas.size * Vector2(0.75, 0.5))
	canvas._finish()
	assert(canvas.zoom_factor == 2.0)
	assert(canvas._image_point(canvas.size / 2).is_equal_approx(Vector2(630, 260)))
	canvas._start(canvas.size / 2)
	canvas._move(canvas.size / 2 + Vector2(40, 0))
	canvas._finish()
	assert(canvas.zoom_factor == 2.0 and canvas.zoom_center.x < 630)
	canvas.set_zoom(4.0, Vector2(-100, 1000))
	assert(canvas._visible_image_rect().position.is_equal_approx(Vector2(0, 390)))
	canvas.set_zoom(2.0, Vector2(630, 260))
	canvas.set_tool("brush")
	canvas._start(canvas.size / 2)
	canvas._finish()
	assert(canvas.artwork.get_pixel(630, 260).is_equal_approx(Color.RED))
	assert(canvas.artwork.get_pixel(420, 260).is_equal_approx(Color.WHITE))
	canvas.undo()
	canvas.set_tool("stamp")
	canvas._start(canvas.size / 2)
	assert(not canvas.artwork.get_pixel(630, 260).is_equal_approx(Color.WHITE))
	canvas.undo()
	canvas.set_tool("brush")
	canvas._start(canvas.size / 2)
	canvas._finish()
	canvas.set_tool("eraser")
	canvas._start(canvas.size / 2)
	canvas._finish()
	assert(canvas.artwork.get_pixel(630, 260).is_equal_approx(Color.WHITE))
	canvas.undo()
	assert(canvas.artwork.get_pixel(630, 260).is_equal_approx(Color.RED))
	var zoom_output := "user://test_zoom_canvas.png"
	assert(canvas.save_artwork(zoom_output) == OK)
	var zoom_saved := Image.load_from_file(zoom_output)
	assert(zoom_saved.get_size() == Vector2i(canvas.WIDTH, canvas.HEIGHT))
	assert(zoom_saved.get_pixel(630, 260).is_equal_approx(Color.RED))
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(zoom_output)) == OK)
	canvas.undo()
	var placed := []
	canvas.text_placement_requested.connect(func(point: Vector2): placed.append(point))
	canvas.text_image = Image.create(1, 1, false, Image.FORMAT_RGBA8)
	canvas.text_image.fill(Color.RED)
	canvas.set_tool("text")
	canvas._start(canvas.size / 2)
	assert(placed[0].is_equal_approx(Vector2(630, 260)))
	assert(canvas.artwork.get_pixel(630, 260).is_equal_approx(Color.RED))
	canvas.undo()
	canvas.set_tool("fill")
	canvas._start(canvas.size / 2)
	assert(canvas.artwork.get_pixel(630, 260).is_equal_approx(Color.RED))
	canvas.undo()
	canvas.set_page(null)
	assert(canvas.zoom_factor == 1.0)

	canvas.set_tool("fill")
	canvas._start(Vector2(20, 20))
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.RED))
	canvas.undo()
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.WHITE))
	for y in range(canvas.HEIGHT):
		canvas.artwork.set_pixel(canvas.WIDTH / 2, y, Color.BLACK)
		canvas.fill_image.set_pixel(canvas.WIDTH / 2, y, Color.BLACK)
	canvas._start(Vector2(20, 20))
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.RED))
	assert(canvas.artwork.get_pixel(canvas.WIDTH - 10, 10).is_equal_approx(Color.WHITE))
	canvas.undo()
	canvas.set_page(null)

	canvas.set_tool("stamp")
	for shape in ["paw", "star", "heart", "sun", "flower", "leopard"]:
		canvas.set_stamp(shape)
		canvas._start(canvas.size / 2)
		assert(not canvas.artwork.get_pixel(canvas.WIDTH / 2, canvas.HEIGHT / 2).is_equal_approx(Color.WHITE))
		canvas.undo()
		assert(canvas.artwork.get_pixel(canvas.WIDTH / 2, canvas.HEIGHT / 2).is_equal_approx(Color.WHITE))

	canvas.set_stamp("leopard")
	canvas.set_brush_size(20.0)
	canvas.set_color(Color.BLUE)
	canvas._start(canvas.size / 2)
	assert(canvas.artwork.get_pixel(420, 260).is_equal_approx(Color.BLUE))
	assert(canvas.artwork.get_pixel(411, 256).is_equal_approx(Color.WHITE))
	assert(canvas.artwork.get_pixel(390, 230).is_equal_approx(Color.WHITE))
	canvas.undo()
	assert(canvas.artwork.get_pixel(420, 260).is_equal_approx(Color.WHITE))
	canvas.set_color(Color.RED)
	canvas.set_glitter(true)
	canvas._start(canvas.size / 2)
	assert(canvas.fill_image.get_pixel(420, 260).is_equal_approx(Color.RED))
	assert(not canvas.artwork.get_pixel(420, 260).is_equal_approx(Color.WHITE))
	canvas.undo()
	canvas.set_glitter(false)
	canvas._start(Vector2(1, 1))
	assert(not canvas.artwork.get_pixel(0, 0).is_equal_approx(Color.WHITE))
	canvas.undo()

	canvas.set_tool("brush")
	canvas._start(canvas.size / 2)
	canvas._finish()
	canvas.set_tool("eraser")
	canvas._start(canvas.size / 2)
	canvas._finish()
	assert(canvas.artwork.get_pixel(canvas.WIDTH / 2, canvas.HEIGHT / 2).is_equal_approx(Color.WHITE))
	canvas.undo()
	assert(canvas.artwork.get_pixel(canvas.WIDTH / 2, canvas.HEIGHT / 2).is_equal_approx(Color.RED))
	canvas.clear_drawing()
	assert(canvas.artwork.get_pixel(canvas.WIDTH / 2, canvas.HEIGHT / 2).is_equal_approx(Color.WHITE))
	canvas.undo()
	assert(canvas.artwork.get_pixel(canvas.WIDTH / 2, canvas.HEIGHT / 2).is_equal_approx(Color.RED))
	var output := "user://test_canvas.png"
	assert(canvas.save_artwork(output) == OK)
	var saved := Image.load_from_file(output)
	assert(saved.get_pixel(canvas.WIDTH / 2, canvas.HEIGHT / 2).is_equal_approx(Color.RED))
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(output)) == OK)

	canvas.set_page(null)
	canvas.set_glitter(true)
	canvas.set_tool("fill")
	canvas._start(Vector2(20, 20))
	assert(not canvas.artwork.get_pixel(0, 0).is_equal_approx(canvas.artwork.get_pixel(1, 0)))
	assert(canvas.save_artwork(output) == OK)
	saved = Image.load_from_file(output)
	assert(not saved.get_pixel(0, 0).is_equal_approx(saved.get_pixel(1, 0)))
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(output)) == OK)
	canvas.set_glitter(false)
	canvas.set_color(Color.BLUE)
	canvas._start(Vector2(20, 20))
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.BLUE))
	assert(canvas.artwork.get_pixel(11, 10).is_equal_approx(Color.BLUE))
	canvas.undo()
	assert(not canvas.artwork.get_pixel(0, 0).is_equal_approx(canvas.artwork.get_pixel(1, 0)))
	canvas.undo()
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.WHITE))

	canvas.set_page(scene.get("page_textures")[3])
	canvas.set_color(Color.RED)
	canvas._start(Vector2(420.0 * canvas.size.x / canvas.WIDTH, 330.0 * canvas.size.y / canvas.HEIGHT))
	assert(canvas.artwork.get_pixel(420, 330).is_equal_approx(Color.RED))
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.WHITE))
	canvas.undo()

	# Check the actual resized school ring and banner stripes against fill leaks.
	canvas.set_page(scene.get("page_textures")[0])
	canvas.set_tool("fill")
	canvas.set_color(Color.RED)
	canvas._start(Vector2(420.0 * canvas.size.x / canvas.WIDTH, 50.0 * canvas.size.y / canvas.HEIGHT))
	assert(canvas.artwork.get_pixel(420, 50).is_equal_approx(Color.RED))
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.WHITE))
	assert(canvas.artwork.get_pixel(420, 115).is_equal_approx(Color.WHITE))
	canvas.undo()
	canvas.set_page(scene.get("page_textures")[1])
	canvas._start(Vector2(420.0 * canvas.size.x / canvas.WIDTH, 364.0 * canvas.size.y / canvas.HEIGHT))
	assert(canvas.artwork.get_pixel(420, 364).is_equal_approx(Color.RED))
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.WHITE))
	assert(canvas.artwork.get_pixel(420, 400).is_equal_approx(Color.WHITE))
	canvas.undo()
	canvas._start(Vector2(126.0 * canvas.size.x / canvas.WIDTH, 214.0 * canvas.size.y / canvas.HEIGHT))
	assert(canvas.artwork.get_pixel(126, 214).is_equal_approx(Color.RED))
	assert(canvas.artwork.get_pixel(10, 10).is_equal_approx(Color.WHITE))
	assert(canvas.artwork.get_pixel(250, 140).is_equal_approx(Color.WHITE))
	canvas.undo()

	scene._open_color_picker()
	await process_frame
	scene._pick_shade(Color("#784fa3"))
	assert(canvas.brush_color.is_equal_approx(Color("#784fa3")))
	scene._toggle_glitter()
	assert(canvas.glitter)
	_test_original_outlines(canvas, scene.page_textures)
	print("Canvas tests passed.")
	quit()

func _test_original_outlines(canvas: DrawingCanvas, page_textures: Array[Texture2D]) -> void:
	var page := Image.create(canvas.WIDTH, canvas.HEIGHT, false, Image.FORMAT_RGBA8)
	page.fill(Color.WHITE)
	for y in range(canvas.HEIGHT):
		page.set_pixel(420, y, Color.BLACK)
	page.set_pixel(419, 260, Color(0.3, 0.3, 0.3))
	canvas.set_page(ImageTexture.create_from_image(page))
	canvas.set_brush_size(36.0)
	canvas.set_color(Color.RED)
	for glitter_enabled in [false, true]:
		canvas.set_glitter(glitter_enabled)
		for selected_tool in ["brush", "stamp", "eraser"]:
			canvas.set_tool(selected_tool)
			canvas.set_stamp("star")
			canvas._start(canvas.size / 2)
			canvas._finish()
			assert(canvas.artwork.get_pixel(420, 260).is_equal_approx(Color.BLACK))
			assert(canvas.artwork.get_pixel(419, 260).is_equal_approx(canvas.base_image.get_pixel(419, 260)))
			assert(canvas.fill_image.get_pixel(420, 260).is_equal_approx(Color.BLACK))
			if selected_tool != "eraser":
				assert(not canvas.artwork.get_pixel(421, 260).is_equal_approx(Color.WHITE))
			canvas.undo()
	canvas.set_glitter(false)
	canvas.set_tool("fill")
	canvas._start(canvas.size / 2)
	assert(canvas.history.is_empty())
	assert(canvas.artwork.get_pixel(420, 260).is_equal_approx(Color.BLACK))
	canvas._start(Vector2(100.0 * canvas.size.x / canvas.WIDTH, 100.0 * canvas.size.y / canvas.HEIGHT))
	assert(canvas.artwork.get_pixel(100, 100).is_equal_approx(Color.RED))
	assert(canvas.artwork.get_pixel(420, 100).is_equal_approx(Color.BLACK))
	assert(canvas.artwork.get_pixel(500, 100).is_equal_approx(Color.WHITE))
	canvas.undo()
	canvas.set_glitter(true)
	canvas._start(Vector2(100.0 * canvas.size.x / canvas.WIDTH, 100.0 * canvas.size.y / canvas.HEIGHT))
	assert(canvas.artwork.get_pixel(420, 100).is_equal_approx(Color.BLACK))
	assert(canvas.artwork.get_pixel(500, 100).is_equal_approx(Color.WHITE))
	canvas.undo()
	canvas.set_glitter(false)
	canvas.text_image = Image.create(30, 20, false, Image.FORMAT_RGBA8)
	canvas.text_image.fill(Color.RED)
	canvas.place_text(Vector2(415, 260))
	assert(canvas.artwork.get_pixel(420, 260).is_equal_approx(Color.BLACK))
	assert(canvas.fill_image.get_pixel(420, 260).is_equal_approx(Color.BLACK))
	assert(canvas.artwork.get_pixel(425, 260).is_equal_approx(Color.RED))
	var output := "user://test_outline.png"
	assert(canvas.save_artwork(output) == OK)
	var saved := Image.load_from_file(output)
	assert(saved.get_pixel(420, 260).is_equal_approx(Color.BLACK))
	assert(saved.get_pixel(425, 260).is_equal_approx(Color.RED))
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(output)) == OK)
	canvas.undo()
	assert(canvas.artwork.get_pixel(425, 260).is_equal_approx(Color.WHITE))
	canvas.set_page(null)
	canvas.set_tool("brush")
	canvas._start(canvas.size / 2)
	canvas._finish()
	assert(canvas.artwork.get_pixel(420, 260).is_equal_approx(Color.RED))
	for page_texture in page_textures:
		if page_texture == null:
			continue
		canvas.set_page(page_texture)
		var line := Vector2i(-1, -1)
		for y in range(canvas.HEIGHT):
			for x in range(canvas.WIDTH):
				if canvas._is_outline(x, y):
					line = Vector2i(x, y)
					break
			if line.x >= 0:
				break
		assert(line.x >= 0)
		var original := canvas.base_image.get_pixelv(line)
		canvas._start(Vector2(line.x * canvas.size.x / canvas.WIDTH, line.y * canvas.size.y / canvas.HEIGHT))
		canvas._finish()
		assert(canvas.artwork.get_pixelv(line).is_equal_approx(original))
