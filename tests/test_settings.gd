extends SceneTree

const Store = preload("res://scripts/settings_store.gd")
const Profiles = preload("res://scripts/profile_store.gd")

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var folder := "user://settings_test_%s" % Time.get_ticks_usec()
	assert(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(folder)) == OK)
	var settings_path := folder.path_join("settings.cfg")
	var profile_path := folder.path_join("profiles.json")
	var fresh := Store.new(settings_path)
	assert(fresh.load_settings(false) == OK and not fresh.setup_complete and fresh.language == "en")
	assert(Store.new(settings_path).load_settings(true) == OK)
	var existing := Store.new(settings_path)
	assert(existing.load_settings(true) == OK and existing.setup_complete)
	assert(fresh.save_settings("es", false) == OK)
	var reloaded := Store.new(settings_path)
	assert(reloaded.load_settings(false) == OK and reloaded.language == "es" and not reloaded.setup_complete)
	assert(reloaded.save_settings("fr", true) == ERR_INVALID_PARAMETER)
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(settings_path)) == OK)

	var scene: Control = load("res://main.tscn").instantiate()
	scene.profile_store = Profiles.new(profile_path)
	scene.settings_store = Store.new(settings_path)
	root.add_child(scene)
	await process_frame
	assert(scene.setup_overlay.visible and scene.setup_step_language.visible)
	var logo: TextureRect = scene.setup_overlay.find_child("SetupLogo", true, false)
	assert(logo != null and logo.texture.resource_path == "res://assets/app_icon/little_leopard_canvas.png")
	assert(logo.size == Vector2(96, 96))
	assert(absf(logo.get_global_rect().get_center().x - scene.size.x / 2.0) < 1.0)
	assert(logo.get_global_rect().position.y >= 0)
	scene._setup_language_changed(1)
	scene.setup_language.select(1)
	assert(TranslationServer.get_locale() == "es")
	assert(TranslationServer.translate("SAVE ART") == "GUARDAR")
	scene._setup_next()
	await process_frame
	assert(logo.is_visible_in_tree() and logo.get_global_rect().position.y >= 0)
	assert(scene.setup_step_artist.get_global_rect().end.y <= scene.size.y)
	scene.setup_name.text = "María"
	scene._setup_back()
	scene._setup_next()
	assert(scene.setup_name.text == "María")
	scene.setup_name.clear()
	scene._finish_setup()
	assert(scene.setup_overlay.visible and scene.setup_message.text == "Please enter your name.")
	scene.setup_name.text = "María"
	scene.setup_grade.select(1)
	scene._finish_setup()
	assert(not scene.setup_overlay.visible)
	assert(scene.profile_store.profiles[0] == {"name": "María", "grade": "4K"})
	var completed := Store.new(settings_path)
	assert(completed.load_settings(false) == OK and completed.setup_complete and completed.language == "es")
	assert(scene.artist_caption.text.contains("ARTISTA"))
	for button in scene.find_children("*", "Button", true, false):
		if button.is_visible_in_tree():
			var bounds: Rect2 = button.get_global_rect()
			assert(bounds.position.x >= 0 and bounds.position.y >= 0)
			assert(bounds.end.x <= scene.size.x and bounds.end.y <= scene.size.y)
	scene._open_settings()
	await process_frame
	assert(scene.settings_dialog.visible)
	assert(scene.settings_dialog.size.y < 500)
	scene._open_profiles_from_settings()
	assert(scene.profile_dialog.visible and not scene.settings_dialog.visible)
	scene.profile_dialog.hide()
	await process_frame
	assert(scene.settings_dialog.visible)
	scene._change_language(0)
	assert(TranslationServer.get_locale() == "en")
	assert(Store.new(settings_path).load_settings(false) == OK)
	var switched := Store.new(settings_path)
	assert(switched.load_settings(false) == OK and switched.language == "en")
	scene.settings_store.path = folder.path_join("missing/settings.cfg")
	scene._change_language(1)
	assert(scene.settings_error_dialog.visible and TranslationServer.get_locale() == "en")
	assert(scene.settings_store.language == "en")
	scene.settings_error_dialog.hide()
	scene.queue_free()
	await process_frame

	var returning: Control = load("res://main.tscn").instantiate()
	returning.profile_store = Profiles.new(profile_path)
	returning.settings_store = Store.new(folder.path_join("legacy.cfg"))
	root.add_child(returning)
	await process_frame
	assert(not returning.setup_overlay.visible and returning.settings_store.setup_complete)
	returning.queue_free()
	await process_frame
	var legacy_folder := folder.path_join("legacy_art")
	assert(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(legacy_folder)) == OK)
	var legacy_picture := legacy_folder.path_join("last_art.png")
	var legacy_file := FileAccess.open(legacy_picture, FileAccess.WRITE)
	legacy_file.store_string("legacy")
	legacy_file.close()
	var legacy: Control = load("res://main.tscn").instantiate()
	legacy.profile_store = Profiles.new(legacy_folder.path_join("profiles.json"))
	legacy.settings_store = Store.new(legacy_folder.path_join("settings.cfg"))
	root.add_child(legacy)
	await process_frame
	assert(not legacy.setup_overlay.visible and legacy.settings_store.setup_complete)
	legacy.queue_free()
	await process_frame
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(legacy_picture)) == OK)
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(legacy_folder)) == OK)
	var resumed_store := Store.new(settings_path)
	assert(resumed_store.save_settings("es", false) == OK)
	var resumed: Control = load("res://main.tscn").instantiate()
	resumed.profile_store = Profiles.new(profile_path)
	resumed.settings_store = Store.new(settings_path)
	root.add_child(resumed)
	await process_frame
	assert(resumed.setup_overlay.visible)
	resumed._setup_next()
	resumed.setup_existing.select(1)
	resumed._setup_artist_chosen(1)
	resumed._finish_setup()
	assert(not resumed.setup_overlay.visible and resumed.profile_store.profiles.size() == 1)
	resumed.queue_free()
	await process_frame
	var corrupt_path := folder.path_join("corrupt.cfg")
	var corrupt := ConfigFile.new()
	corrupt.set_value("settings", "language", "fr")
	corrupt.set_value("settings", "setup_complete", true)
	assert(corrupt.save(corrupt_path) == OK)
	var invalid := Store.new(corrupt_path)
	assert(invalid.load_settings(false) == ERR_FILE_CORRUPT)
	TranslationServer.set_locale("en")
	for path in [settings_path, profile_path, corrupt_path]:
		assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(path)) == OK)
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(folder)) == OK)
	print("Settings and first-time setup tests passed.")
	quit()
